/* ===== Root ===== */
QWidget#weather_app {
    background-color: #0b1220;
}

QWidget#weather_app[weatherTheme="clear"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #082f49, stop:1 #4338ca);
}

QWidget#weather_app[weatherTheme="clouds"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #111827, stop:1 #334155);
}

QWidget#weather_app[weatherTheme="rain"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #020617, stop:1 #164e63);
}

QWidget#weather_app[weatherTheme="snow"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0f172a, stop:1 #64748b);
}

QWidget#weather_app[weatherTheme="atmosphere"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #18181b, stop:1 #52525b);
}

QWidget#weather_app[weatherTheme="error"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1f1215, stop:1 #7f1d1d);
}

/* ===== Base text ===== */
QLabel, QComboBox, QLineEdit, QPushButton {
    font-family: Segoe UI, Calibri;
    color: #e6edff;
    background-color: transparent;
}

/* ===== City label ===== */
QLabel#city_label {
    font-size: 22px;
    font-weight: 500;
    color: #c7d6ff;
}

/* ===== Input ===== */
QComboBox#city_input,
QComboBox#unit_input {
    font-size: 18px;
    min-height: 26px;
    padding: 8px 40px 8px 14px;
    border-radius: 12px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    background-color: rgba(2, 6, 23, 0.82);
}

QComboBox#city_input:focus,
QComboBox#unit_input:focus {
    border: 1px solid #3b82f6;
    background-color: #020617;
}

QComboBox#city_input::drop-down,
QComboBox#unit_input::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid rgba(148, 163, 184, 0.22);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(15, 23, 42, 0.8);
}

QComboBox#city_input::drop-down:hover,
QComboBox#unit_input::drop-down:hover {
    background-color: #1e293b;
}

QComboBox#city_input::down-arrow,
QComboBox#unit_input::down-arrow {
    image: url("__CHEVRON_DOWN_ICON__");
    width: 16px;
    height: 16px;
}

QComboBox#city_input QAbstractItemView,
QComboBox#unit_input QAbstractItemView {
    background-color: #020617;
    border: 1px solid #1e293b;
    selection-background-color: #2563eb;
    color: #e6edff;
}

/* ===== Button ===== */
QPushButton#get_weather_button {
    font-size: 15px;
    font-weight: 600;
    min-height: 26px;
    padding: 10px;
    border-radius: 12px;
    background-color: #3b82f6;
    border: 1px solid rgba(191, 219, 254, 0.22);
}

QPushButton#get_weather_button:hover {
    background-color: #2563eb;
}

QPushButton#get_weather_button:pressed {
    background-color: #1e40af;
}

/* ===== Cards ===== */
QFrame#main_frame {
    background-color: rgba(2, 6, 23, 0.78);
    border-radius: 16px;
    border: 1px solid rgba(226, 232, 240, 0.14);
}

QFrame#extra_frame {
    background-color: transparent;
}

/* ===== Temperature ===== */
QLabel#temperature_label {
    font-size: 72px;
    font-weight: 700;
    color: #ffffff;
}

/* ===== Emoji ===== */
QLabel#emoji_label {
    font-size: 80px;
    margin-top: 6px;
}

/* ===== Description ===== */
QLabel#description_label {
    font-size: 18px;
    color: #c7d6ff;
    margin-bottom: 6px;
}

/* ===== Extra info ===== */
QLabel#feels_like_label,
QLabel#min_max_label,
QLabel#humidity_label,
QLabel#wind_label,
QLabel#sunrise_sunset_label {
    font-size: 13px;
    color: #9fb3ff;
}
